From ee1e6993ad43a881c54f7fa240ed7db46f387707 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 16 Nov 2026 08:55:19 +0000
Subject: [PATCH] EXP-020: 256-hidden NNUE (gen-2 data)

nets/apex-gen2b-256.nnue (sha256 5a8751c8...7428), apex-768x256x2-1,
trained on the same 29.9M gen-1 + gen-2 positions as gen2a, 15 epochs,
held-out MSE 0.006977 (gen2a: about 0.00735). Build: APEX_NNUE_HIDDEN=256.
bench: 86926

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01G5iCbWbUZgUFhzRNanL4Ca
---
 CMakeLists.txt           |   4 ++--
 nets/apex-gen2b-256.nnue | Bin 0 -> 394770 bytes
 2 files changed, 2 insertions(+), 2 deletions(-)
 create mode 100644 nets/apex-gen2b-256.nnue

diff --git a/CMakeLists.txt b/CMakeLists.txt
index e5201f4..e52bca4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -46,7 +46,7 @@ find_package(Threads REQUIRED)
 
 # Default NNUE network, embedded in the binary so the engine never silently runs
 # without it (ARCHITECTURE.md section 5). Override with -DAPEX_NET=<file>.
-set(APEX_NET "${CMAKE_SOURCE_DIR}/nets/apex-gen2a.nnue" CACHE FILEPATH "NNUE network embedded in the binary")
+set(APEX_NET "${CMAKE_SOURCE_DIR}/nets/apex-gen2b-256.nnue" CACHE FILEPATH "NNUE network embedded in the binary")
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${APEX_NET}")
 file(READ "${APEX_NET}" APEX_NET_HEX HEX)
 string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," APEX_NET_BYTES "${APEX_NET_HEX}")
@@ -70,7 +70,7 @@ add_library(apex_core STATIC
 )
 target_include_directories(apex_core PUBLIC src)
 target_include_directories(apex_core PRIVATE "${CMAKE_BINARY_DIR}/generated")
-set(APEX_NNUE_HIDDEN 128 CACHE STRING "NNUE hidden layer size (multiple of 128); must match APEX_NET")
+set(APEX_NNUE_HIDDEN 256 CACHE STRING "NNUE hidden layer size (multiple of 128); must match APEX_NET")
 target_compile_definitions(apex_core PUBLIC APEX_NNUE_HIDDEN=${APEX_NNUE_HIDDEN})
 target_link_libraries(apex_core PUBLIC Threads::Threads)
 
diff --git a/nets/apex-gen2b-256.nnue b/nets/apex-gen2b-256.nnue
new file mode 100644
index 0000000000000000000000000000000000000000..facb88b7a51b3c87cdfbd311d9b3990cf9bbdc6a
